{
  "name": "atl2026",
  "private": true,
  "version": "0.1.0",
  "description": "AIM Academy — Awaken The Lions 2026: event registration & tracking platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.js apps/*/test/*.test.js supabase/test/*.test.js",
    "test:qr": "node --test packages/qr-token/test/*.test.js",
    "test:db": "node --test supabase/test/*.test.js",
    "test:concurrency": "node --env-file=.env.local scripts/concurrency.mjs",
    "test:write-load": "node --env-file=.env.local scripts/write-load.mjs",
    "test:register-load": "node --env-file=.env.local scripts/register-load.mjs",
    "test:failover": "node --env-file=.env.local scripts/failover-drill.mjs",
    "test:ramp": "node scripts/ramp-load.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
